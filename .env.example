# Copy to .env and add your own credentials. Never commit .env.
# Adzuna API: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Keep false until written commercial permission is in place.
ADZUNA_COMMERCIAL_LICENSE_CONFIRMED=false

# USAJOBS API key + the email used in your API application:
# https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

API_PORT=8787
